\name{gicsurv-package}
\alias{gicsurv-package}
\alias{gicsurv}
\docType{package}
\title{Penalised B-spline hazard regression for generalised interval-censored data}
\description{
Fits proportional hazards models for datasets containing exact,
right-censored, interval-censored and double-interval-censored observations.
The baseline hazard is a nonnegative penalised B-spline and its smoothing
parameter is selected by cross-validation.
}
\usage{
gicsurv(...)
}
\arguments{
  \item{...}{Arguments passed to \code{shiny::runApp()}.}
}
\value{The launcher is called for its side effect of opening the Shiny app.}
