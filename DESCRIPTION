Package: gicsurv
Title: Penalised B-Spline Hazard Regression for Generalised Interval-Censored Data
Version: 0.1.0
Authors@R: c(
    person("Jordache", "Ramjith", email = "jordache.ramjith@radboudumc.nl",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0003-4431-7395")),
